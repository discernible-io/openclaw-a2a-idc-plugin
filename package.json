{
    "name": "@identyclaw/openclaw-a2a-plugin",
    "version": "0.4.1",
    "description": "IdentyClaw fork of the OpenClaw A2A plugin with RODiT / Passport JWT authentication for peer agents.",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "openclaw.plugin.json",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc",
        "prepare:publish": "npm run build && node ./scripts/verify-pack.mjs",
        "publish:clawhub:dry-run": "node ./scripts/publish-clawhub.mjs --dry-run",
        "publish:clawhub": "node ./scripts/publish-clawhub.mjs",
        "check": "biome check .",
        "check:fix": "biome check --write .",
        "typecheck": "tsc --noEmit",
        "test": "bun test",
        "test:coverage": "bun test --coverage",
        "test:e2e": "RUN_E2E=1 bun test tests/e2e"
    },
    "openclaw": {
        "extensions": [
            "./dist/index.js"
        ],
        "compat": {
            "pluginApi": ">=2026.5.17",
            "minGatewayVersion": "2026.5.17"
        },
        "build": {
            "openclawVersion": "2026.5.17",
            "pluginSdkVersion": "2026.5.17"
        }
    },
    "keywords": [
        "a2a",
        "agent-to-agent",
        "openclaw",
        "plugin"
    ],
    "author": "IdentyClaw",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/discernible-io/openclaw-a2a-idc-plugin.git"
    },
    "bugs": {
        "url": "https://github.com/discernible-io/openclaw-a2a-idc-plugin/issues"
    },
    "homepage": "https://github.com/discernible-io/openclaw-a2a-idc-plugin#readme",
    "dependencies": {
        "@a2a-js/sdk": "^0.3.10",
        "@a2anet/a2a-utils": "^0.7.2",
        "@rodit/rodit-auth-be": "9.11.20",
        "@sinclair/typebox": "^0.34.0",
        "undici": "^6.26.0",
        "ws": "^8.19.0",
        "zod": "^3.25.0",
        "zod-to-json-schema": "^3.25.1"
    },
    "peerDependencies": {
        "openclaw": ">=2026.5.17"
    },
    "devDependencies": {
        "@biomejs/biome": "^1.9.0",
        "@types/bun": "latest",
        "@types/ws": "^8.0.0",
        "openclaw": "^2026.5.17",
        "typescript": "^5.7.0"
    },
    "trustedDependencies": [
        "@biomejs/biome"
    ],
    "engines": {
        "node": ">=22.19.0"
    }
}
